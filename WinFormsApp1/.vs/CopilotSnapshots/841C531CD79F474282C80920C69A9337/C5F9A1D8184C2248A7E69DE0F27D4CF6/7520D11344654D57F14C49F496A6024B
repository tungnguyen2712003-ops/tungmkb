    {
        private double[] positions = new double[3];
        private bool[] autoRunning = new bool[3];

        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // start timer
            autoTimer.Start();

            // Wire demo events
            if (stylishButton1 != null) stylishButton1.Click += (s, ev) => AddAlarm("BTN01", "Stylish button clicked");
            if (twoPositionSwitch1 != null) twoPositionSwitch1.Toggled += (s, ev) => AddAlarm("SW01", $"Switch: {twoPositionSwitch1.Position}");

            // sample alarms
            AddAlarm("E01", "Overtemperature");
            AddAlarm("W02", "Near limit");
        }


    }
