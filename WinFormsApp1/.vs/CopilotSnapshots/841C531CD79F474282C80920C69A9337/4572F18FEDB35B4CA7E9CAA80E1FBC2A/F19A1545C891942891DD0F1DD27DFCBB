using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using System.Windows.Forms;
using YamlDotNet.Serialization;
using YamlDotNet.Serialization.NamingConventions;

namespace WinFormsApp1
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            var path = "hardware.yaml";
            try
            {
                var axis1 = ReadAxisConfig(path);

                if (axis1 != null)
                {
                    var info = $"Axis data:\n" +
                               $"Card: {axis1.Card}\n" +
                               $"Slave: {axis1.Slave}\n" +
                               $"AxisId: {axis1.AxisId}\n" +
                               $"Encoder: {axis1.Encoder}\n" +
                               $"Lead: {axis1.Lead}\n" +
                               $"Eqiv: {axis1.Eqiv}\n" +
                               $"JogSpeed: {axis1.JogSpeed}\n" +
                               $"HomeMethod: {axis1.HomeMethod}\n" +
                               $"HomeLowSpeed: {axis1.HomeLowSpeed}\n" +
                               $"HomeHighSpeed: {axis1.HomeHighSpeed}\n" +
                               $"MinSpeed: {axis1.MinSpeed}\n" +
                               $"MaxSpeed: {axis1.MaxSpeed}\n" +
                               $"Acceleration: {axis1.Acceleration}\n" +
                               $"Deceleration: {axis1.Deceleration}\n" +
                               $"LimitNegative: {axis1.LimitNegative}\n" +
                               $"LimitPositive: {axis1.LimitPositive}";

                    MessageBox.Show(info, "AxisX", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error reading hardware.yaml: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private AxisConfig ReadAxisConfig(string path)
        {
            // Try several candidate locations when a relative path is provided.
            var candidates = new List<string>();
            if (Path.IsPathRooted(path))
                candidates.Add(path);
            else
            {
                candidates.Add(path); // as given (working directory)
                candidates.Add(Path.Combine(AppContext.BaseDirectory, path)); // next to exe
                candidates.Add(Path.Combine(Environment.CurrentDirectory, path));
                // try walking up from the exe folder to reach project root (bin\Debug\netX\..\..\..)
                try
                {
                    var dir = new DirectoryInfo(AppContext.BaseDirectory);
                    var up = dir.Parent?.Parent?.Parent; // three levels up to project folder
                    if (up != null)
                        candidates.Add(Path.Combine(up.FullName, path));
                }
                catch { }
            }

            string found = null;
            foreach (var c in candidates)
            {
                if (string.IsNullOrWhiteSpace(c)) continue;
                if (File.Exists(c))
                {
                    found = c;
                    break;
                }
            }

            if (found == null)
            {
                MessageBox.Show($"hardware.yaml not found. Tried:\n{string.Join("\n", candidates)}", "YAML Missing", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return null;
            }

            var yaml = File.ReadAllText(found);
            var deserializer = new DeserializerBuilder()
                .WithNamingConvention(CamelCaseNamingConvention.Instance)
                .Build();

            var map = deserializer.Deserialize<Dictionary<string, AxisConfig>>(yaml);
            if (map != null && map.ContainsKey("AxisX"))
                return map["AxisX"];
            if (map != null && map.Count > 0)
                return map.Values.FirstOrDefault();
            return null;
        }

        private class AxisConfig
        {
            public int Card { get; set; }
            public int Slave { get; set; }
            public int AxisId { get; set; }
            public long Encoder { get; set; }
            public int Lead { get; set; }
            public int Eqiv { get; set; }
            public int JogSpeed { get; set; }
            public int HomeMethod { get; set; }
            public int HomeLowSpeed { get; set; }
            public int HomeHighSpeed { get; set; }
            public int MinSpeed { get; set; }
            public int MaxSpeed { get; set; }
            public double Acceleration { get; set; }
            public double Deceleration { get; set; }
            public int LimitNegative { get; set; }
            public int LimitPositive { get; set; }
        }
    }
}
