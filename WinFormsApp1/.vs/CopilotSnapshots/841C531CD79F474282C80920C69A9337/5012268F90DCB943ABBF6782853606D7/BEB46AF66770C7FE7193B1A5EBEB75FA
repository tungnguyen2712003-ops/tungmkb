using System;
using System.IO;
using System.Collections.Generic;
using System.Drawing;
using System.Windows.Forms;
using YamlDotNet.Serialization;
using YamlDotNet.Serialization.NamingConventions;

namespace WinFormsApp1
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // read hardware.yaml if it exists next to executable in specified path
            var path = @"C:\Users\tungn\source\repos\WinFormsApp1\WinFormsApp1\hardware.yaml";
            try
            {
                if (File.Exists(path))
                {
                    var yaml = File.ReadAllText(path);
                    var deserializer = new DeserializerBuilder()
                        .WithNamingConvention(CamelCaseNamingConvention.Instance)
                        .Build();
                    var data = deserializer.Deserialize<Dictionary<string, object>>(yaml);

                    // show top-level keys in a messagebox for demo; in real app populate UI instead
                    if (data != null)
                    {
                        var keys = string.Join(", ", data.Keys);
                        MessageBox.Show($"Loaded hardware.yaml keys: {keys}", "YAML Loaded", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                }
                else
                {
                    MessageBox.Show($"hardware.yaml not found at: {path}", "YAML Missing", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error reading hardware.yaml: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }

            // set form background image (wing) if present in same folder as hardware.yaml or in images subfolder
            try
            {
                string baseDir = Path.GetDirectoryName(path) ?? AppDomain.CurrentDomain.BaseDirectory;
                var candidates = new[] { "wing.png", "background_wing.png", "wing.jpg", "wing.jpeg" };
                string found = null;
                foreach (var c in candidates)
                {
                    var p = Path.Combine(baseDir, c);
                    if (File.Exists(p)) { found = p; break; }
                    // also check images subfolder
                    p = Path.Combine(baseDir, "images", c);
                    if (File.Exists(p)) { found = p; break; }
                    p = Path.Combine(baseDir, "resources", c);
                    if (File.Exists(p)) { found = p; break; }
                }

                if (found != null)
                {
                    try
                    {
                        var img = Image.FromFile(found);
                        this.BackgroundImage = img;
                        this.BackgroundImageLayout = ImageLayout.Stretch;
                    }
                    catch (Exception ex)
                    {
                        // image load failed, show warning but continue
                        MessageBox.Show($"Unable to load background image: {ex.Message}", "Image Load", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    }
                }
                else
                {
                    // no image found — silent ok or notify if you prefer
                }
            }
            catch { }
        }
    }
}
